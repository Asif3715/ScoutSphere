# Copy to .env (never commit .env)
POSTGRES_USER=scoutsphere
POSTGRES_PASSWORD=scoutsphere
POSTGRES_DB=scoutsphere
ENVIRONMENT=local
DEBUG=true
# Used when running the backend outside Docker:
DATABASE_URL=postgresql+asyncpg://scoutsphere:scoutsphere@localhost:5433/scoutsphere
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Auth (generate a long random value for anything but local dev: openssl rand -hex 32)
JWT_SECRET=dev-only-insecure-secret-change-me
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=5
REFRESH_TOKEN_DAYS=14
# Sign-in throttling (per email / per IP within the window)
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=30
# Player photos (local disk under MEDIA_ROOT; signed links live 1-2 windows of MEDIA_URL_HOURS)
MEDIA_ROOT=media
MEDIA_URL_HOURS=2
INVITATION_DAYS=7
#
# Outside local/test (ENVIRONMENT=staging or production) the backend refuses to start unless:
# JWT_SECRET is random and 32+ characters, DATABASE_URL does not use the default password,
# COOKIE_SECURE=true, DEBUG=false, and CORS_ORIGINS / FRONTEND_URL are https and not localhost.
