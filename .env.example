# Copy to .env (never commit .env)
POSTGRES_USER=scoutsphere
POSTGRES_PASSWORD=scoutsphere
POSTGRES_DB=scoutsphere
ENVIRONMENT=local
DEBUG=true
# Used when running the backend outside Docker:
DATABASE_URL=postgresql+asyncpg://scoutsphere:scoutsphere@localhost:5433/scoutsphere
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
